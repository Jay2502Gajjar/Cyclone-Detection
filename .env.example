# Copy to .env and adjust. Nothing here is secret in local development.

# --- Database (docker compose up -d postgres) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cyclovision
SPRING_DATASOURCE_USERNAME=cyclovision
SPRING_DATASOURCE_PASSWORD=cyclovision
DATABASE_URL=postgresql://cyclovision:cyclovision@localhost:5433/cyclovision

# --- Backend ---
AI_SERVICE_URL=http://localhost:8000
MODELS_DIR=../models
MEDIA_DIR=../data
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Forces every forecast to come from stored demo scenarios, stamped DEMO_DATA.
# Insurance for a live demo; it can never masquerade as a real model.
DEMO_MODE=false

# --- AI service ---
FRAMES_DIR=../data/frames
BUNDLE_VERSION=phase0
LOG_LEVEL=INFO

# --- Frontend ---
# Empty uses the Vite dev proxy.
VITE_API_BASE_URL=
