# =============================================================
# CycloVision Backend — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials.
# =============================================================

# Backend Server
SERVER_PORT=8080

# Supabase PostgreSQL Database (REQUIRED)
# Get these from your Supabase project → Settings → Database
SUPABASE_DB_URL=jdbc:postgresql://<your-supabase-host>.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-supabase-db-password>

# Alternatively, use generic DB_ vars (SUPABASE_ takes precedence)
# DB_URL=jdbc:postgresql://host:5432/dbname
# DB_USERNAME=user
# DB_PASSWORD=pass

# AI Service Connection (future — not yet implemented)
AI_SERVICE_URL=http://localhost:8000

# Ingestion Scheduler (set to false to disable auto-ingestion on startup)
CYCLOVISION_SCHEDULER_ENABLED=true
