# =============================================================
# CycloVision Data Integration — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- OpenWeather API ---
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# --- Timeouts ---
REQUEST_TIMEOUT_SECONDS=3

# --- Demo Mode ---
# Set to "true" to force demo/fallback data instead of live API calls.
# When "false", the system attempts live data first, falling back to demo on failure.
DEMO_MODE=true

# --- Data Paths (override defaults if needed) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_DEMO_DIR=data/demo

# --- IBTrACS ---
IBTRACS_BASIN=NI
IBTRACS_VERSION=v04r01
